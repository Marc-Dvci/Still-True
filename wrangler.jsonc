{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-true",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
